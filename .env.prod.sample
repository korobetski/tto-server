# The deployed host's environment, for `compose.prod.yaml`. Copy to /srv/tto/.env on the VPS.
#
# Unlike .env.sample this file describes a place where the values are real. Two rules follow from
# that, and neither is a suggestion:
#
#   * every password here is generated on this host and used nowhere else. `openssl rand -base64 24`
#   * this file never enters the repository, a chat, or a backup that is not encrypted.
#     `chmod 600 /srv/tto/.env`, owned by the deploy user.
#
# Keep every value alphanumeric. Compose expands `$` and treats `#` as a comment, so a generated
# password containing either fails in a way that looks exactly like a wrong password. If the
# generator produces one, generate another.

# ---- What CI writes ------------------------------------------------------------------------------
#
# Set by scripts/deploy.sh on every deployment and on every rollback. Present here only so that the
# file is complete; editing it by hand is how the running container and this file stop agreeing.
TTO_IMAGE=ghcr.io/korobetski/tto-server:v0.1.0

# ---- TLS -----------------------------------------------------------------------------------------
#
# The DNS name pointing at this VPS. It must already resolve to the host's public address **before**
# the first `docker compose up`: Caddy asks Let's Encrypt for a certificate on start, and a failed
# validation counts against a rate limit that is measured in hours.
TTO_DOMAIN=tto.example.com
# Where certificate-expiry and validation-failure warnings are sent. A real inbox someone reads.
TTO_TLS_EMAIL=you@example.com
# The administration console's hostname — a sibling name pointing at this same VPS, and the only
# host from which /admin/* is reachable. Leave it unset until that DNS record exists and the
# console has been deployed: unset means Caddy serves the portal and the API exactly as before and
# the console's site block matches nothing. Setting it is also what `tto-web`'s CI needs, as the
# CONSOLE_SITE repository variable, before it will deploy the console at all.
#TTO_ADMIN_DOMAIN=admintto.example.com

# ---- Where a failed scheduled job reports ---------------------------------------------------------
#
# A Discord webhook URL — Server Settings → Integrations → Webhooks → Copy Webhook URL.
#
# **This URL is a credential.** Anyone holding it can post to that channel as the webhook, forever,
# with no other authentication. It belongs here and in no repository, no chat and no screenshot.
#
# Leave it blank and failures still land in the journal; nothing breaks, nobody is told. That is the
# state this whole mechanism exists to end, so it is worth two minutes.
TTO_ALERT_URL=

# ---- The database --------------------------------------------------------------------------------
#
# Two roles, and the separation is the whole point — see docs/operations.md. The superuser owns the
# cluster and is what backup.sh and psql use; the application role is what the server authenticates
# as and can do nothing but read and write the application's own tables.
#
# ⚠️ Both pairs are read by the Postgres image **only when the data directory is empty**. On a volume
# that already exists, changing them here does nothing at all. .env.sample carries the psql commands
# for rotating them on a live volume.
POSTGRES_USER=tripletriad
POSTGRES_PASSWORD=
POSTGRES_DB=tripletriad

DATABASE_USER=tto_app
DATABASE_PASSWORD=
# Raise in response to a measurement, not a worry. Note that Postgres's own max_connections is the
# real ceiling, and this pool is not the only thing that connects.
DATABASE_POOL_SIZE=10

# ---- The statistics reader, and the schema it reads ------------------------------------------------
#
# ⚠️ **Before deploying the first image that contains V18__stats_views.sql**, the `stats` schema has
# to exist on this host. The migration creates the views; it cannot create the schema, because
# `tto_app` has no CREATE on the database and giving it one would undo the point of the role. On a
# fresh volume docker/postgres/init/20-stats-role.sh does it. This volume is not fresh, so:
#
#   docker compose -f compose.prod.yaml exec postgres \
#     psql -U tripletriad -d tripletriad -v ON_ERROR_STOP=1 \
#     -c "CREATE SCHEMA IF NOT EXISTS stats AUTHORIZATION tto_app"
#
# Skip it and the deployment fails on start-up with `permission denied for database` and exit 70 —
# the schema is not optional, it is where the console's dashboard reads its figures from.
#
# STATS_DB_PASSWORD is the optional half. It creates `tto_stats`, a role that may SELECT the stats
# views and reach nothing else — not `accounts`, not `sessions`, not an email address. It exists for
# whatever looks at the numbers from outside the server, which today means a Grafana reached over an
# SSH tunnel; the console does not use it, because the server reads those views as itself.
#
# Set it before the first boot and the init script creates the role. Afterwards, by hand:
#
#   docker compose -f compose.prod.yaml exec postgres \
#     psql -U tripletriad -d tripletriad -v ON_ERROR_STOP=1 \
#     -c "CREATE ROLE tto_stats LOGIN PASSWORD 'the-value-below'" \
#     -c "GRANT CONNECT ON DATABASE tripletriad TO tto_stats" \
#     -c "GRANT USAGE ON SCHEMA stats TO tto_stats" \
#     -c "GRANT SELECT ON ALL TABLES IN SCHEMA stats TO tto_stats" \
#     -c "ALTER DEFAULT PRIVILEGES FOR ROLE tto_app IN SCHEMA stats GRANT SELECT ON TABLES TO tto_stats"
#
# Four grants rather than the one the init script does, because this runs *after* the migration: the
# views already exist, so they have to be granted explicitly as well as by default. And `FOR ROLE
# tto_app` rather than the bare form the migration uses — default privileges attach to whoever
# creates the object, so typed as the superuser without it, they would apply to views the superuser
# makes, which is none of them.
STATS_DB_PASSWORD=

# ---- What this deployment says about itself --------------------------------------------------------
#
# Answered on `GET /server`, the one route never behind the version gate — a client too old to be
# served still has to be able to learn why, and where to get the build that would be.
#
# TTO_CLIENT_VERSION is the newest client build this deployment knows of, as `major.minor.patch`.
# Blank means "nothing to announce", which stays correct until there is a download behind it:
# announcing a version a player cannot obtain is worse than announcing nothing.
TTO_SERVER_NAME=Triple Triad
TTO_CLIENT_VERSION=
TTO_CLIENT_DOWNLOAD_ANDROID=
TTO_CLIENT_DOWNLOAD_DESKTOP=
TTO_CLIENT_DOWNLOAD_IOS=
TTO_CLIENT_NOTES=

# ---- Sending mail ----------------------------------------------------------------------------------
#
# Confirmation codes and password resets leave through Brevo's transactional API rather than this
# host's own SMTP: an OVH VPS sits in a hosting provider's address space, outbound 25 is restricted
# there, and mail that does get out lands in spam often enough that "reset your password" arriving
# in a spam folder means a player who cannot get back in.
#
# **BREVO_API_KEY is a secret**, and unlike the passwords above it is not generated here — it is
# issued by Brevo and can be revoked there. It belongs in this file and nowhere else. Note that
# `docker inspect` shows a container's environment, so anyone with docker on this host has it.
#
# It is also **required**: outside development the server refuses to boot without it, deliberately.
# The fallback writes each code into the log, and a log line containing a live credential on a
# deployed host is worse than a server that will not start.
#
# MAIL_FROM must be a sender Brevo has verified or every send is refused. Give it a subdomain that
# carries no other traffic — `mail.example.com` — so this mail's sending reputation stands on its
# own, and add that subdomain's SPF, DKIM and DMARC records where Brevo tells you to.
BREVO_API_KEY=
MAIL_FROM=no-reply@mail.example.com
MAIL_SENDER_NAME=Triple Triad

# ---- The first administrator ---------------------------------------------------------------------
#
# Set these two for **one** deployment, sign in to the console, then clear them again. There is no
# other way to create the first administrator, deliberately: a route that did it would be either
# unauthenticated — anybody on the internet enrolling into the console — or authenticated, which is
# the chicken and the egg. A variable and a restart is a credential only somebody with this host has.
#
# ⚠️ TTO_ADMIN_PASSWORD is a secret. Generate it in a password manager, 12 characters at the very
# least, and keep it there rather than here once the first sign-in is done. `docker inspect` shows a
# container's environment, so anyone with docker on this host holds whatever is set.
#
# Sign in **immediately** after the boot that creates the account. Until the first sign-in completes,
# the password alone is enough to enrol an authenticator, so whoever holds the password first chooses
# the second factor. After it, the secret is not replaceable by anybody holding the password — which
# is also why a lost authenticator is a `psql` statement rather than a "forgot my phone" link.
#
# Leaving these set across a redeploy does nothing: an administrator who already exists is never
# touched — not the password, not the second factor, not `disabled_at` — so a restart is not a
# password reset and a retired administrator does not come back. Clear them anyway.
#
# `docs/operations.md` has a second administrator, a lost authenticator and withdrawing access.
TTO_ADMIN_USERNAME=
TTO_ADMIN_PASSWORD=

# ---- What level opens which door ---------------------------------------------------------------------
#
# Refereed play and the auction house stay shut until a profile reaches a level. The *rule* is in
# `:core` so this server and the client cannot disagree about it; these are the *numbers*, and they
# are answered on `GET /server` — so raising one is this variable and a restart, not a client
# release.
#
# Blank or unparseable means `:core`'s defaults (5 and 5), which is why a typo here costs the
# default rather than the boot. This gate is what makes a rigged PvP match expensive: a second
# account has to be played up to the threshold before it can feed the first. Email confirmation
# does not do that job and never did — plus-addressing and disposable inboxes are free.
TTO_UNLOCK_MULTIPLAYER=
TTO_UNLOCK_AUCTION=

# ---- The accounts this server plays itself -------------------------------------------------------
#
# Off unless this says otherwise, and that is the point: a server that populates its own lobby is a
# different product from one that does not, and nobody should get it by deploying a new tag.
#
# A bot is an ordinary account with an ordinary profile. It grinds solo matches, answers a lobby
# table nobody else took after TTO_BOTS_TABLE_WAIT_SECONDS, buys packs with what it earns, uses the
# cards and potions that land in its bag, sells its surplus commons (which is about the Random rule
# as much as the money), and keeps three decks — strongest, most concentrated in one type, most
# spread across types — choosing between them from the rules a table or an opponent declares. It is
# driven in-process — see `BotDirector` and `BotDecks` — so none of the rate limits apply to it and
# the cadence below is what stands in their place.
#
# Four things worth deciding rather than inheriting, all of them in `operations.md`:
#
#   * Nothing on the wire marks a bot. TTO_BOTS_NAME_PREFIX is the whole of what a player can read.
#   * A fresh roster starts at level 1 and TTO_UNLOCK_MULTIPLAYER is 5, so the lobby does not fill
#     until the bots have climbed. Hours, not minutes.
#   * TTO_BOTS_WAGER moves real value: a card won from a bot is a card the world gained. Leave it
#     off until the `tto_bots_*` metrics say what it would cost.
#   * TTO_BOTS_COUNT is CPU. Every placement at EXPERT is a depth-five search on the process that
#     serves requests.
#
# Blank means the default in every case, and an unreadable value costs the dial rather than the boot.
TTO_BOTS_ENABLED=
TTO_BOTS_COUNT=
TTO_BOTS_BAND=
TTO_BOTS_FORMAT=
TTO_BOTS_NAME_PREFIX=
TTO_BOTS_WAGER=
TTO_BOTS_RESERVE=
TTO_BOTS_TABLE_WAIT_SECONDS=
TTO_BOTS_MOVE_MIN_SECONDS=
TTO_BOTS_MOVE_SPREAD_SECONDS=
TTO_BOTS_IDLE_SECONDS=
TTO_BOTS_TICK_SECONDS=
