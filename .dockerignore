# Everything here would otherwise be sent to the daemon as build context on every build, and
# `build/` alone is hundreds of megabytes of output the image must not contain anyway.
.git
.github
.gradle
.kotlin
build
*.iml
.idea

# Never inside an image.
.env

docs
scripts
README.md

# The deployment topology. Read by compose on the VPS, never by a build — and `compose.prod.yaml`
# in particular must not be reachable from inside an image that it starts.
compose.prod.yaml
Caddyfile
.env.prod.sample
