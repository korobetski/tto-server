# The deployed host's environment, for `compose.prod.yaml`. Copy to /srv/tto/.env on the VPS.
#
# Unlike .env.sample this file describes a place where the values are real. Two rules follow from
# that, and neither is a suggestion:
#
#   * every password here is generated on this host and used nowhere else. `openssl rand -base64 24`
#   * this file never enters the repository, a chat, or a backup that is not encrypted.
#     `chmod 600 /srv/tto/.env`, owned by the deploy user.
#
# Keep every value alphanumeric. Compose expands `$` and treats `#` as a comment, so a generated
# password containing either fails in a way that looks exactly like a wrong password. If the
# generator produces one, generate another.

# ---- What CI writes ------------------------------------------------------------------------------
#
# Set by scripts/deploy.sh on every deployment and on every rollback. Present here only so that the
# file is complete; editing it by hand is how the running container and this file stop agreeing.
TTO_IMAGE=ghcr.io/korobetski/tto-server:v0.1.0

# ---- TLS -----------------------------------------------------------------------------------------
#
# The DNS name pointing at this VPS. It must already resolve to the host's public address **before**
# the first `docker compose up`: Caddy asks Let's Encrypt for a certificate on start, and a failed
# validation counts against a rate limit that is measured in hours.
TTO_DOMAIN=tto.example.com
# Where certificate-expiry and validation-failure warnings are sent. A real inbox someone reads.
TTO_TLS_EMAIL=you@example.com

# ---- Where a failed scheduled job reports ---------------------------------------------------------
#
# A Discord webhook URL — Server Settings → Integrations → Webhooks → Copy Webhook URL.
#
# **This URL is a credential.** Anyone holding it can post to that channel as the webhook, forever,
# with no other authentication. It belongs here and in no repository, no chat and no screenshot.
#
# Leave it blank and failures still land in the journal; nothing breaks, nobody is told. That is the
# state this whole mechanism exists to end, so it is worth two minutes.
TTO_ALERT_URL=

# ---- The database --------------------------------------------------------------------------------
#
# Two roles, and the separation is the whole point — see docs/operations.md. The superuser owns the
# cluster and is what backup.sh and psql use; the application role is what the server authenticates
# as and can do nothing but read and write the application's own tables.
#
# ⚠️ Both pairs are read by the Postgres image **only when the data directory is empty**. On a volume
# that already exists, changing them here does nothing at all. .env.sample carries the psql commands
# for rotating them on a live volume.
POSTGRES_USER=tripletriad
POSTGRES_PASSWORD=
POSTGRES_DB=tripletriad

DATABASE_USER=tto_app
DATABASE_PASSWORD=
# Raise in response to a measurement, not a worry. Note that Postgres's own max_connections is the
# real ceiling, and this pool is not the only thing that connects.
DATABASE_POOL_SIZE=10

# ---- What this deployment says about itself --------------------------------------------------------
#
# Answered on `GET /server`, the one route never behind the version gate — a client too old to be
# served still has to be able to learn why, and where to get the build that would be.
#
# TTO_CLIENT_VERSION is the newest client build this deployment knows of, as `major.minor.patch`.
# Blank means "nothing to announce", which stays correct until there is a download behind it:
# announcing a version a player cannot obtain is worse than announcing nothing.
TTO_SERVER_NAME=Triple Triad
TTO_CLIENT_VERSION=
TTO_CLIENT_DOWNLOAD_ANDROID=
TTO_CLIENT_DOWNLOAD_DESKTOP=
TTO_CLIENT_DOWNLOAD_IOS=
TTO_CLIENT_NOTES=

# ---- Sending mail ----------------------------------------------------------------------------------
#
# Confirmation codes and password resets leave through Brevo's transactional API rather than this
# host's own SMTP: an OVH VPS sits in a hosting provider's address space, outbound 25 is restricted
# there, and mail that does get out lands in spam often enough that "reset your password" arriving
# in a spam folder means a player who cannot get back in.
#
# **BREVO_API_KEY is a secret**, and unlike the passwords above it is not generated here — it is
# issued by Brevo and can be revoked there. It belongs in this file and nowhere else. Note that
# `docker inspect` shows a container's environment, so anyone with docker on this host has it.
#
# It is also **required**: outside development the server refuses to boot without it, deliberately.
# The fallback writes each code into the log, and a log line containing a live credential on a
# deployed host is worse than a server that will not start.
#
# MAIL_FROM must be a sender Brevo has verified or every send is refused. Give it a subdomain that
# carries no other traffic — `mail.example.com` — so this mail's sending reputation stands on its
# own, and add that subdomain's SPF, DKIM and DMARC records where Brevo tells you to.
BREVO_API_KEY=
MAIL_FROM=no-reply@mail.example.com
MAIL_SENDER_NAME=Triple Triad

# ---- What level opens which door ---------------------------------------------------------------------
#
# Refereed play and the auction house stay shut until a profile reaches a level. The *rule* is in
# `:core` so this server and the client cannot disagree about it; these are the *numbers*, and they
# are answered on `GET /server` — so raising one is this variable and a restart, not a client
# release.
#
# Blank or unparseable means `:core`'s defaults (5 and 5), which is why a typo here costs the
# default rather than the boot. This gate is what makes a rigged PvP match expensive: a second
# account has to be played up to the threshold before it can feed the first. Email confirmation
# does not do that job and never did — plus-addressing and disposable inboxes are free.
TTO_UNLOCK_MULTIPLAYER=
TTO_UNLOCK_AUCTION=
