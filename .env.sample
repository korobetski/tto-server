# Local development environment for `compose.yaml`. Copy to `.env`, which is git-ignored.
#
#   cp .env.sample .env
#
# Every value below except GRADLE_PROPERTIES is already the default baked into `compose.yaml`;
# override those when they collide with something already running — most often POSTGRES_PORT, if a
# Postgres is already installed on the host. GRADLE_PROPERTIES has no default that could be right on
# more than one machine, so it must be set.
#
# Nothing here is a secret and nothing here may be reused on a deployed host. The server refuses
# to start with default credentials unless TTO_ENV names a development environment; see
# ServerConfig.kt.

# ---- The database superuser -------------------------------------------------------------------
#
# Owns the cluster. It is the account for psql, backups and restores — **not** the one the server
# connects with; see DATABASE_USER below for why those are two different roles.
#
# ⚠️ POSTGRES_USER and POSTGRES_PASSWORD are read by the Postgres image **only when the data
# directory is empty**. Changing either one here does nothing to a volume that already exists — the
# server keeps the old password and the new value is silently ignored, which looks like the change
# not taking effect rather than like a rule. To rotate it on a live volume:
#
#   docker compose exec postgres psql -U tripletriad -c "ALTER ROLE tripletriad PASSWORD 'new'"
#
# ...and then change it here so the two agree. Or start over with `docker compose down -v`, which
# DESTROYS the data.
POSTGRES_USER=tripletriad
POSTGRES_PASSWORD=generate-one-per-machine-and-never-reuse-it
POSTGRES_DB=tripletriad

# ---- The application role ----------------------------------------------------------------------
#
# What the server authenticates as. Deliberately not the superuser: nothing the server does needs
# to create roles or drop databases, so a leaked password here costs the application's own tables
# rather than the cluster. Created on first boot by docker/postgres/init/10-app-role.sh, which
# reads exactly these two values — so they are the role's definition, not a copy of it.
#
# The same ⚠️ applies: on a volume that already exists the init script does not re-run, and the
# role has to be created by hand:
#
#   docker compose exec postgres psql -U tripletriad -d tripletriad \
#     -c "CREATE ROLE tto_app LOGIN PASSWORD 'the-value-below'" \
#     -c "GRANT CONNECT ON DATABASE tripletriad TO tto_app" \
#     -c "GRANT USAGE, CREATE ON SCHEMA public TO tto_app"
#
# And there is a second half that is easy to miss. A volume that previously ran with the server
# connecting as the superuser already holds tables **owned by that superuser** — starting with
# `flyway_schema_history`. The new role can create its own objects but has no rights on those, so
# the server fails its migration with `permission denied for table flyway_schema_history` and exits
# 70. Hand them over — **all** of them, and the sequences too:
#
#   docker compose exec -T postgres psql -U tripletriad -d tripletriad -v ON_ERROR_STOP=1 -c "DO \$\$
#     DECLARE r record; BEGIN
#       FOR r IN SELECT tablename AS n FROM pg_tables WHERE schemaname='public' LOOP
#         EXECUTE format('ALTER TABLE public.%I OWNER TO tto_app', r.n); END LOOP;
#       FOR r IN SELECT sequencename AS n FROM pg_sequences WHERE schemaname='public' LOOP
#         EXECUTE format('ALTER SEQUENCE public.%I OWNER TO tto_app', r.n); END LOOP;
#     END \$\$"
#
# This block used to name `flyway_schema_history` alone, and that was a trap: `accounts`,
# `pvp_tables` and the rest are owned by the superuser for exactly the same reason, so ceding one
# table buys one migration's worth of progress and the same error under a different table name.
# Every object in `public`, or none of them.
#
# Ownership and not `GRANT ALL`, which would look like it worked. A migration does `ALTER TABLE`,
# and only an owner may — so grants carry V1-V9 (already applied, nothing to alter) and fail on the
# first migration that changes a column. The failure would arrive on a future deploy, detached from
# the cause.
#
# A fresh volume never has this problem, because there is nothing for the superuser to have made
# first.
#
# Keep both values alphanumeric. Compose expands `$` inside .env and treats `#` as a comment, so a
# password containing either fails in a way that looks like a wrong password.
DATABASE_USER=tto_app
DATABASE_PASSWORD=generate-one-per-machine-and-never-reuse-it

# ---- What this deployment says about itself ----------------------------------------------------
#
# Read on every start, and answered on `GET /server` — the one route that is never behind the
# version gate, because a client the gate would refuse still has to be able to learn *why*.
#
# TTO_CLIENT_VERSION is the newest client build this deployment knows of, as `major.minor.patch`.
# Leave it blank and the app is told nothing, which is correct until there is a build to point at:
# announcing a version with no download behind it produces a notice the player cannot act on.
#
# The three download URLs are per platform and are never substituted for one another — an Android
# player sent to a desktop installer is worse off than one told only that they need to update. Note
# that the app **opens** these; it does not install them. On Android and iOS the store owns updates,
# and a desktop in-app updater would need signed artifacts and a verified release channel.
#
# TTO_SERVER_NAME is what the player sees in the app's server list next to the address.
TTO_SERVER_NAME=Triple Triad (local)
TTO_CLIENT_VERSION=
TTO_CLIENT_DOWNLOAD_ANDROID=
TTO_CLIENT_DOWNLOAD_DESKTOP=
TTO_CLIENT_DOWNLOAD_IOS=
TTO_CLIENT_NOTES=

# ---- Sending mail --------------------------------------------------------------------------------
#
# Confirmation codes and password resets go out through Brevo's transactional API. Not through this
# host's own SMTP: a VPS sits in a hosting provider's address space, outbound port 25 is restricted
# there, and mail that does leave lands in spam often enough that a password-reset mail in a spam
# folder means a locked-out player.
#
# Leave BREVO_API_KEY blank for local development and the server writes each code to its log
# instead of sending it, which is how you finish a registration on a laptop with no inbox. That
# fallback is refused outside development — see MailConfig.from — because the log line contains a
# credential.
#
# ⚠️ The key is a secret. Set it in `.env`, never here, and never in a file that is committed.
# `docker inspect` shows a container's environment, so treat a host that runs this as holding it.
#
# MAIL_FROM wants to be a subdomain that carries no other traffic (`mail.example.com`), so this
# mail's sending reputation stands on its own and a bounce storm cannot take the main domain with
# it. It must be a sender Brevo has verified, or every send is refused.
BREVO_API_KEY=
MAIL_FROM=no-reply@localhost
MAIL_SENDER_NAME=Triple Triad

# ---- What level opens which door -----------------------------------------------------------------
#
# Refereed play and the auction house are closed until a profile reaches a level. The *rule* lives
# in `:core` so the client and this server cannot disagree about it; the *numbers* are these, and
# they are sent to clients on `GET /server` — so raising one is this variable and a restart, not a
# client release.
#
# Blank or unparseable means `:core`'s own defaults (5 and 5). The gate is what makes a rigged PvP
# match expensive: a second account has to be played to the threshold before it can feed the first.
TTO_UNLOCK_MULTIPLAYER=
TTO_UNLOCK_AUCTION=

# Host ports. Both containers always listen on their standard port internally.
POSTGRES_PORT=5432
TTO_PORT=8080

# ---- Reading `com.tripletriad:core` --------------------------------------------------------------
#
# The client's rules engine is published from the `tto-core` repository to GitHub Packages, which
# demands authentication even for a public package. Your Gradle home file carries the credentials
# and is mounted into the image build as a secret — never copied into a layer. Compose does not
# expand `~`, so this has to be an absolute path with forward slashes:
#
#   Linux / macOS   /home/you/.gradle/gradle.properties
#   Windows         C:/Users/you/.gradle/gradle.properties
#
# That file needs two properties, and a GitHub token with `read:packages` and nothing more:
#
#   gpr.user=your-github-username
#   gpr.key=ghp_...
#
# It lives outside the repository on purpose. Do not move it in, and do not put the token here —
# this file is read by `docker compose` and its contents end up in `docker inspect`.
#
# The alternative, for trying an unreleased engine change: publish `:core` locally instead, from
# the client repository. `settings.gradle.kts` prefers that copy when it exists.
#
#   cd ../AS3-Triple-Triad && ./gradlew :core:publishToMavenLocal
#
GRADLE_PROPERTIES=
