# Runs one logical backup. Started by tto-backup.timer, never enabled on its own.
#
# Installed once, by hand — see docs/operations.md § Backups. Deliberately not installed by the
# deployment: a release should not be able to change what runs as root on a schedule, and a unit
# that a workflow can rewrite is a unit a compromised workflow can rewrite.

[Unit]
Description=Logical backup of the Triple Triad database
# The dump talks to a container. Without this the unit can fire during boot, fail on a daemon that
# is not up, and leave a failure in the journal that means nothing.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/tto
ExecStart=/srv/tto/scripts/backup.sh

# How many dumps to keep in /srv/tto/backups. That directory is inside the VPS image OVH takes each
# day, so this number is also how far back a single OVH restore can reach.
Environment=BACKUP_KEEP=14

# A dump of a small database takes seconds. If it has not finished in ten minutes something is
# wrong, and a run that hangs forever is one that the next day's run collides with.
TimeoutStartSec=600

# Output goes to the journal, so `journalctl -u tto-backup` is the whole history of this job.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
